# ============================================================================
# TOCS — environment produksi.
#
#   cp .env.production.example .env.production
#   nano .env.production            # isi semua yang bertanda GENERATE
#   chmod 600 .env.production
#
# Berkas .env.production TIDAK boleh masuk git (sudah ada di .gitignore).
# ============================================================================

DOMAIN=tektok.kameranusantara.id
PUBLIC_URL=https://tektok.kameranusantara.id

# Email pendaftaran Let's Encrypt (untuk notifikasi sertifikat kedaluwarsa).
CERTBOT_EMAIL=projekin.ajaa@gmail.com

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tocs
# GENERATE: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=tocs

# --- Auth -------------------------------------------------------------------
# GENERATE: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Password superuser pertama. Kosongkan untuk mendapat password acak yang
# dicetak sekali ke log saat `db:seed` dijalankan.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Presence ---------------------------------------------------------------
IDLE_AFTER_SECONDS=60
OFFLINE_AFTER_SECONDS=180
LOW_BATTERY_THRESHOLD=20

# --- Object storage (MinIO) -------------------------------------------------
MINIO_ACCESS_KEY=tocsadmin
# GENERATE: openssl rand -hex 24
MINIO_SECRET_KEY=
MINIO_BUCKET=tocs-media

# --- Streaming (LiveKit) ----------------------------------------------------
# Signalling lewat Nginx sebagai wss://, karena halaman HTTPS memblokir ws://
# sebagai mixed content. Path /livekit di-proxy ke container livekit:7880.
LIVEKIT_URL=wss://tektok.kameranusantara.id/livekit

LIVEKIT_API_KEY=TOCSprod
# GENERATE: openssl rand -hex 32   (LiveKit menolak secret yang terlalu pendek)
LIVEKIT_API_SECRET=
