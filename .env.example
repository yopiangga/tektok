# ============================================================================
# TOCS — environment template. Copy to .env and adjust before deploying.
# ============================================================================

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tocs
POSTGRES_PASSWORD=tocs
POSTGRES_DB=tocs
DATABASE_URL=postgres://tocs:tocs@localhost:5432/tocs

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# --- HTTP -------------------------------------------------------------------
# Socket.IO memvalidasi header Origin, jadi setiap alamat yang dipakai browser
# harus terdaftar di sini — termasuk alamat LAN bila diakses dari perangkat lain.
# Cari alamat LAN: ipconfig getifaddr en0 (macOS) / hostname -I (Linux)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
PUBLIC_URL=http://localhost:5173

# --- Jaringan lokal ---------------------------------------------------------
# Alamat LAN mesin ini. Dipakai docker-compose.dev.yml untuk LiveKit --node-ip
# agar ICE candidate yang diiklankan dapat dijangkau perangkat lain; tanpa ini
# LiveKit mengiklankan IP jaringan Docker dan video tidak pernah sampai.
# HOST_IP=192.168.1.10

# --- Presence rules ---------------------------------------------------------
IDLE_AFTER_SECONDS=60
OFFLINE_AFTER_SECONDS=180
LOW_BATTERY_THRESHOLD=20

# --- Object storage (MinIO) -------------------------------------------------
# Provided by `npm run infra:up`. If MinIO is unreachable the API automatically
# falls back to the local ./backend/uploads directory, so this can stay on.
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=tocsadmin
MINIO_SECRET_KEY=tocsadmin123
MINIO_BUCKET=tocs-media

# --- Streaming (LiveKit) ----------------------------------------------------
# Requires a running LiveKit server: `npm run infra:up`.
# The API probes it and reports the real state, so leaving this on when the
# server is down degrades to preview mode instead of failing silently.
# Set to false only to hard-disable streaming.
LIVEKIT_ENABLED=true

# Client-facing URL. Leave as 'auto' to derive it from the host the browser
# used — required for field phones, which cannot reach the server's localhost.
# Pin it only for a fixed public/TLS endpoint, e.g. wss://livekit.example.com
LIVEKIT_URL=auto
LIVEKIT_PORT=7880

# Server-side address used only for the health probe.
LIVEKIT_INTERNAL_URL=http://localhost:7880

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret0123456789
